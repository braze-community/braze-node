{
  "name": "braze-api",
  "version": "2.13.4",
  "description": "Track users, send messages, export data, and more with Braze API.",
  "author": "Mark <mark@remarkablemark.org>",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./cjs/index.js"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.build.json",
    "build:esm": "npm run build:cjs -- --module nodenext --outDir esm",
    "clean": "rm -rf cjs coverage docs esm",
    "docs": "typedoc",
    "docs:watch": "npm run docs -- --watch",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run lint && npm run lint:tsc && npm run test:ci && npm run test:esm && npm run clean && npm run build",
    "test": "jest",
    "test:ci": "CI=true jest --ci --colors --coverage",
    "test:esm": "npm run build:esm && node --test src/index.test.mjs",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braze-community/braze-node.git"
  },
  "bugs": {
    "url": "https://github.com/braze-community/braze-node/issues"
  },
  "keywords": [
    "braze",
    "api",
    "rest",
    "node",
    "appboy"
  ],
  "dependencies": {
    "@types/node-fetch": "2.6.6",
    "node-fetch": "2.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "fetch-mock-jest": "1.5.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-watch-typeahead": "3.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "files": [
    "cjs/",
    "esm/"
  ],
  "engines": {
    "node": ">=14"
  },
  "license": "MIT"
}

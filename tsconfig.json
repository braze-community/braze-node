{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["node", "jest"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["src", "*.mjs", "*.mts", "*.ts"]
}
